# Copy this file to .env and fill in the keys. The .env file is ignored by git.
# A key goes only here. Do not put a key in a config file or on a command line.

# OpenRouter: candidate modes and the judge.
OPENROUTER_API_KEY=

# Google Gemini API, direct route. Use a key of the paid tier: the free tier
# uses the content to improve the products of the vendor.
GEMINI_API_KEY=

# Speech to text suite.
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
